# Public hostnames. External HTTPS is terminated by the owner's root Nginx;
# no port 443 or certificate material belongs in this stack.
COMMON_DOMAIN=example.com
SITE_SUBDOMAIN=sewer-net
APP_SUBDOMAIN=sewer-net-app

# Router port on loopback only. Public mapping stays in the owner's Nginx.
ROUTER_PORT=8080

# Optional outbound proxy for the backend's external Matrix traffic.
# Leave empty unless the host requires an outbound proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
