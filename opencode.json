{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "open-codebase-index"
  ],
  "plugin": [
    "open-codebase-index"
  ],
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": [
        "npx",
        "nx",
        "mcp"
      ],
      "enabled": true
    }
  },
  "instructions": [
    "AGENTS.md",
    "CREDENTIALS.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".nx/**",
      "dist/**",
      "build/**",
      ".next/**",
      "out/**",
      "coverage/**",
      "*.lock"
    ]
  },
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 25000
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": "20%"
  }
}