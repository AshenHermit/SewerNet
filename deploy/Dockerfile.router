# syntax=docker/dockerfile:1.7
FROM node:24.11.0-bookworm-slim@sha256:87ccbf5cc428351bc8e242a9e43ceb998ec546c33a08fe77a839227c9142ab7e AS builder
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@10.34.9 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches patches
COPY apps/web/package.json apps/web/package.json
COPY libs libs
RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY nx.json tsconfig.base.json tsconfig.json lingui.config.ts ./
RUN pnpm nx sync
RUN pnpm nx build web --configuration=production

FROM caddy:2.10.2-alpine@sha256:d8c17a862962def15cde69863a3a463f25a2664942eafd7bdbf050e9c3116b83

# Install envsubst for runtime env var substitution
RUN apk add --no-cache gettext

# Copy Caddyfile (for policy test) and as template (for runtime substitution)
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY deploy/Caddyfile /etc/caddy/Caddyfile.template
COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

COPY --from=builder /workspace/apps/web/dist /srv/web

EXPOSE 80

ENTRYPOINT ["docker-entrypoint.sh"]
