# HTTP-only router. TLS is terminated by the owner's root Nginx; this process
# never binds 443, never runs ACME and never issues redirects.
{
  auto_https off
}

# Marketing site: static Next.js export behind landing:8080.
{$SITE_HOST}:80 {
  encode zstd gzip

  # /api/* must never reach the private REST proxy through a public hostname.
  @api path_regexp api ^/api/
  handle @api {
    respond 404
  }

  handle {
    reverse_proxy landing:8080
  }
}

# Web client: SPA from the web dist baked into this image.
{$APP_HOST}:80 {
  root * /srv/web
  encode zstd gzip

  @api path_regexp api ^/api/
  handle @api {
    respond 404
  }

  handle {
    # Hashed Vite assets (JS and WASM) are immutable.
    @assets path_regexp assets ^/assets/
    header @assets Cache-Control "public, max-age=31536000, immutable"
    # Ensure .js files have correct MIME (file_server may miss .js in some Vite chunks)
    @assets_js path_regexp assets_js ^/assets/.*\.js$
    header @assets_js Content-Type "application/javascript; charset=utf-8"

    # App shell and service worker must never be stale.
    @shell path / /sw.js /welcome /oidc/callback
    header @shell Cache-Control "no-store"

    try_files {path} {path}/index.html /index.html
    file_server
  }
}

# Unknown Host: explicit 404, never site or app content.
:80 {
  respond 404
}
