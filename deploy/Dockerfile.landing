# syntax=docker/dockerfile:1.7
FROM node:24.11.0-bookworm-slim@sha256:87ccbf5cc428351bc8e242a9e43ceb998ec546c33a08fe77a839227c9142ab7e AS builder
WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/landing/package.json apps/landing/package.json
COPY libs libs
RUN npm ci

COPY apps/landing apps/landing
COPY nx.json tsconfig.base.json tsconfig.json ./
RUN npx nx sync
RUN npx nx build landing --configuration=production

FROM caddy:2.10.2-alpine@sha256:d8c17a862962def15cde69863a3a463f25a2664942eafd7bdbf050e9c3116b83
WORKDIR /srv
COPY --from=builder /workspace/apps/landing/out ./
COPY deploy/Caddyfile.landing /etc/caddy/Caddyfile
EXPOSE 8080
